# Rust / Cangjie 构建产物（`target/` 无锚定，覆盖任意层级；`/target-*` 只锚根）
target/
/target-*
.probe/

# 前端依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# Python 缓存
__pycache__/
*.pyc

# 本地运行数据与日志
/var
*.log

# 能力宿主的运行期反馈/事件落盘（启动即生成）
/apps/ability-core/data/

# 控制台在本地创建的运行期声明（不属于示例集，不入库）
/config/sources/111.yaml
/config/plans/111-*.yaml

# 仅本地保留的文档、参考实现与笔记
/docs
/manual
.reference/
/AGENT.md

# 本地 IDE/Agent 会话产物（审计、日志、prompt 快照）
/.atomcode
